{
  "name": "tangram-layers-monorepo",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Tangram rendering and deck.gl integration packages",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "dev-modules/*",
    "modules/*",
    "examples/**/*",
    "website"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/tangram-layers.git"
  },
  "homepage": "https://visgl.github.io/tangram-layers/",
  "scripts": {
    "start": "yarn workspace @vis.gl/tangram-renderer watch",
    "bootstrap": "yarn install && ocular-bootstrap",
    "clean": "ocular-clean",
    "website:start": "yarn workspace tangram-layers-website start",
    "website:build": "yarn workspace tangram-layers-website build",
    "website:deploy": "yarn workspace tangram-layers-website deploy",
    "build": "yarn clean && yarn workspace @vis.gl/tangram-renderer build && yarn workspace @vis.gl/tangram-layers build && yarn workspace @vis.gl/tangram-classic build",
    "build:packages": "yarn build",
    "bundle-size": "node scripts/report-bundle-size.mjs",
    "lint": "yarn lint:licenses && ocular-lint && yarn workspace @vis.gl/tangram-renderer lint",
    "lint:fix": "yarn lint:licenses:fix && ocular-lint fix && yarn workspace @vis.gl/tangram-renderer lint",
    "lint:licenses": "node scripts/check-license-headers.mjs",
    "lint:licenses:fix": "node scripts/check-license-headers.mjs --write",
    "test": "yarn lint && yarn test-run && yarn test-node && yarn test-headless-legacy",
    "test-fast": "yarn lint && yarn test-node",
    "test-node": "ocular-test node",
    "test-browser": "ocular-test browser",
    "test-headless": "ocular-test headless",
    "test-headless-legacy": "TANGRAM_VITEST_LEGACY=1 ocular-test headless",
    "test-coverage": "ocular-test headless --coverage",
    "typecheck": "tsc --noEmit",
    "playwright:install": "playwright install chromium",
    "test-website": "yarn website:build",
    "test-run": "yarn test-build-worker && ESM=false karma start karma.conf.js --browsers Chrome --single-run",
    "test-run-headless": "yarn test-build-worker && ESM=false karma start karma.conf.js --browsers ChromeHeadlessWebGL --single-run",
    "test-build-worker": "yarn workspace @vis.gl/tangram-renderer test-build-worker",
    "karma-start": "karma start karma.conf.js --browsers Chrome --no-watch",
    "karma-run": "karma run karma.conf.js --browsers Chrome",
    "publish:beta": "ocular-publish version-only-beta",
    "publish:prod": "ocular-publish version-only-prod"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.29.0",
    "@deck.gl/core": "^9.4.0-alpha.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/pluginutils": "^5.1.3",
    "@vis.gl/dev-tools": "2.0.0-alpha.6",
    "@vitest/coverage-v8": "^4.0.18",
    "chai": "^4.5.0",
    "eslint": "7.8.1",
    "fast-async": "6.3.8",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "karma-rollup-preprocessor": "^7.0.8",
    "karma-sinon": "^1.0.5",
    "mocha": "^11.0.1",
    "playwright": "^1.58.0",
    "rollup": "4.20.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-node-builtins": "^2.1.2",
    "rollup-plugin-node-globals": "^1.4.0",
    "rollup-plugin-serve": "^1.1.1",
    "rollup-plugin-sourcemaps2": "^0.4.2",
    "rollup-plugin-string-import": "^1.2.5",
    "sinon": "^19.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
