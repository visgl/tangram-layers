{
  "name": "tangram-layers-website",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Documentation and examples website for Tangram layers",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "prepare-assets": "yarn workspace @vis.gl/tangram-renderer build && yarn workspace @vis.gl/tangram-layers build && yarn workspace @vis.gl/tangram-classic build && node scripts/copy-assets.mjs",
    "start": "yarn prepare-assets && docusaurus start",
    "build": "yarn prepare-assets && docusaurus build",
    "serve": "docusaurus serve",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/preset-classic": "^3.9.2",
    "@mdx-js/react": "^3.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/plugin-content-docs": "^3.9.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not op_mini all"
  ]
}
